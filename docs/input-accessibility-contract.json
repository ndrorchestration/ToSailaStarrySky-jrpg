  "settingsPersistence": {
    "saveSlotsOwnSettings": false,
    "plannedDesktopOwner": "nw.App.dataPath/settings.json (implemented)",
    "plannedBrowserFallback": "localStorage (implemented)",
    "migrationRequired": true
  },
  "phasedImplementation": [
    "semantic action registry + validation",
    "runtime input adapter while preserving current keyboard behavior",
    "focus manager + controller polling",
    "settings persistence + settings UI reachable from title",
    "text/motion/audio/subtitle rendering integration",
    "First Wake benchmark keyboard/controller parity and accessibility regression coverage"
  ],
  "deferred": [
    "full screen narration",
    "assistive-technology-specific platform certification",
    "platform storefront accessibility metadata",
    "localization-specific subtitle line-breaking"
  ],
  "research": [
    "Microsoft Xbox Accessibility Guideline 107 — Input",
    "Microsoft Xbox Accessibility Guideline 112 — UI navigation",
    "Microsoft Xbox Accessibility Guideline 113 — UI focus handling",
    "Microsoft Xbox Accessibility Guideline 117 — Visual distractions and motion settings",
    "Game Accessibility Guidelines — Basic / Intermediate / remappable controls / subtitle customization"
  ],
  "implementedNow": [
    "semantic keyboard action registry with context-specific bindings",
    "deterministic shared focus manager",
    "save/load overlay focus integration with non-color marker and stable slot restoration",
    "standard-mapping gamepad polling through navigator.getGamepads()",
    "context-prioritized gamepad semantic adapter",
    "live controller dispatch for BOOT, title, Settings, Controls, authored opening, WORLD, dialogue, read-only overlays, COMBAT, SAVELOAD, and AIRSHIP",
    "bounded controller movement repeat equivalent to keyboard movement cadence",
    "deterministic combat action focus with non-color marker and canonical resolveTurn activation",
    "single-press controller Save/Load route through gameplay Menu button",
    "independent schema-v1 user settings persistence",
    "independent schema-v1 input-binding persistence with fail-closed conflict validation",
    "action-remapping UI for keyboard/gamepad with reset-to-defaults",
    "dynamic player prompts sourced from active input bindings",
    "Settings reachable before gameplay from keyboard or controller",
    "representative First Wake text scaling across title, opening, WORLD HUD, overlays, choice/wake/epilogue, character sheet, flight, and combat UI",
    "high-contrast palette and vignette suppression",
    "subtitle visibility, size, background, and speaker-label rendering policy",
    "reduced-motion, screen-shake, text-speed runtime integration",
    "effects-volume and dialogue-volume runtime integration",
    "canonical fail-safe runtime music bus with persisted Music Volume integration",
    "controller vibration with graceful unsupported-hardware fallback",
    "live Playwright controller-parity regression covering settings, remapping, opening, WORLD, Save/Load, dialogue, flight, combat focus, rendering settings, and vibration"
  ],
  "remainingBeforeRepresentativeParity": [
    "rendered visual acceptance at text scales 100/125/150/175 with high-contrast and subtitle combinations",
    "exact-head execution of the live controller-parity and First Wake benchmark regressions",
    "packaged title-track asset registration and exact-candidate playback verification"
  ]
}
