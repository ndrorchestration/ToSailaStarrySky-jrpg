{
  "version": 1,
  "status": "foundation-implemented-partial",
  "purpose": "Provide a live semantic input, focus, settings, and accessibility foundation before Aetherwake multiplies menus, party UI, regions, and content.",
  "principles": [
    "Gameplay and UI bind to semantic actions, not hard-coded physical keys.",
    "Every required action has a single-press digital path.",
    "Keyboard and gamepad can navigate the entire representative slice.",
    "Player remapping is action-based and visible prompts must reflect the active mapping.",
    "UI focus order is deterministic, visible, and never depends on color alone.",
    "Accessibility settings are reachable before gameplay and remembered separately from save slots.",
    "Important information is not conveyed by audio or fixed color alone.",
    "Player-controlled text advance remains available and motion/distraction can be reduced."
  ],
