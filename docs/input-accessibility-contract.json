  "focusContract": {
    "deterministicDirectionalOrder": true,
    "alwaysVisibleFocus": true,
    "focusIndicatorMustNotUseColorAlone": true,
    "restoreFocusOnClose": true,
    "noHiddenFocusedControls": true,
    "consistentConfirmCancel": true
  },
  "settings": [
    {
      "id": "text-scale",
      "type": "enum",
      "values": [
        "100",
        "125",
        "150",
        "175"
      ],
      "default": "125",
      "persistence": "user-settings"
    },
    {
      "id": "high-contrast-ui",
      "type": "boolean",
      "default": false,
      "persistence": "user-settings"
    },
    {
      "id": "reduced-motion",
      "type": "boolean",
      "default": false,
      "persistence": "user-settings"
    },
    {
      "id": "screen-shake",
      "type": "enum",
      "values": [
        "off",
        "low",
        "full"
      ],
      "default": "low",
      "persistence": "user-settings"
    },
    {
      "id": "subtitles",
      "type": "boolean",
      "default": true,
      "persistence": "user-settings"
    },
    {
      "id": "subtitle-size",
      "type": "enum",
      "values": [
        "medium",
        "large",
        "extra-large"
      ],
      "default": "large",
      "persistence": "user-settings"
    },
    {
      "id": "subtitle-background",
      "type": "enum",
      "values": [
        "off",
        "soft",
        "strong"
      ],
      "default": "soft",
      "persistence": "user-settings"
    },
    {
      "id": "speaker-labels",
      "type": "boolean",
      "default": true,
      "persistence": "user-settings"
    },
    {
      "id": "music-volume",
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 80,
      "persistence": "user-settings"
    },
    {
      "id": "effects-volume",
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 80,
      "persistence": "user-settings"
    },
    {
      "id": "dialogue-volume",
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 100,
      "persistence": "user-settings"
    },
    {
      "id": "text-speed",
      "type": "enum",
      "values": [
        "slow",
        "normal",
        "fast",
        "instant"
      ],
      "default": "normal",
      "persistence": "user-settings"
    },
    {
      "id": "controller-vibration",
      "type": "enum",
      "values": [
        "off",
        "low",
        "full"
      ],
      "default": "low",
      "persistence": "user-settings"
    }
  ],
  "settingsPersistence": {
    "saveSlotsOwnSettings": false,
    "plannedDesktopOwner": "nw.App.dataPath/settings.json",
    "plannedBrowserFallback": "localStorage",
    "migrationRequired": true
  },
  "phasedImplementation": [
    "semantic action registry + validation",
    "runtime input adapter while preserving current keyboard behavior",
    "focus manager + controller polling",
    "settings persistence + settings UI reachable from title",
    "text/motion/audio/subtitle rendering integration",
    "First Wake benchmark keyboard/controller parity and accessibility regression coverage"
  ],
  "deferred": [
    "full screen narration",
    "assistive-technology-specific platform certification",
    "platform storefront accessibility metadata",
    "localization-specific subtitle line-breaking"
  ],
  "research": [
    "Microsoft Xbox Accessibility Guideline 107 — Input",
    "Microsoft Xbox Accessibility Guideline 112 — UI navigation",
    "Microsoft Xbox Accessibility Guideline 113 — UI focus handling",
    "Microsoft Xbox Accessibility Guideline 117 — Visual distractions and motion settings",
    "Game Accessibility Guidelines — Basic / Intermediate / remappable controls / subtitle customization"
  ]
}
