      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 80,
      "persistence": "user-settings"
    },
    {
      "id": "dialogue-volume",
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 100,
      "persistence": "user-settings"
