{
  "name": "Aetherwake",
  "version": "0.2.0",
  "description": "Aetherwake pre-alpha — a solarpunk turn-based JRPG built with p5.js",
  "main": "index-embedded.html",
  "window": {
    "title": "AETHERWAKE — THE LAST SOLARPUNK AIRSHIP",
    "width": 960,
    "height": 640,
    "min_width": 800,
    "min_height": 500,
    "toolbar": false,
    "resizable": true,
    "icon": "icon.svg",
    "position": "center",
    "show": true,
    "frame": true,
    "fullscreen": false,
    "kiosk": false,
    "focus": true
  },
  "webkit": {
    "plugin": false,
    "page-cache": true
  },
  "js-flags": "--expose-gc",
  "devDependencies": {
    "playwright": "^1.63.0",
    "nw-builder": "4.20.0"
  },
  "private": true,
  "scripts": {
    "test:smoke": "node tests/smoke-playwright.js",
    "playwright:install": "playwright install chromium",
    "test:runtime-contracts": "node tests/runtime-contracts.test.js",
    "test:combat-policy": "node tests/combat-system-policy.test.js",
    "test:combat-formula": "node tests/combat-formula.test.js",
    "test:effects": "node tests/effect-vocabulary.test.js",
    "test:registries": "node tests/registry-contract.test.js",
    "test:resolver": "node tests/effect-resolver.test.js",
    "test:resolver-integration": "node tests/resolver-integration.test.js",
    "test:enemy-metadata": "node tests/enemy-metadata-contract.test.js",
    "test:combat-input": "node tests/combat-input-contract.test.js",
    "test:resource-eligibility": "node tests/resource-eligibility.test.js",
    "test:progression-reachability": "node tests/progression-reachability.test.js",
    "test:secondary-action": "node tests/secondary-action-contract.test.js",
    "test:airship": "node tests/airship-state.test.js",
    "test:air-navigation": "node tests/air-navigation.test.js",
    "test:airship-combat-bridge": "node tests/airship-combat-bridge.test.js",
    "test:all": "npm run test:runtime-contracts && npm run test:runtime-authority && npm run test:pixel-sprites && npm run test:pixel-tiles && npm run test:pixel-airship-art && npm run test:pixel-presentation && npm run test:pixel-world-ambient && npm run test:combat-policy && npm run test:combat-formula && npm run test:jrpg-input && npm run test:jrpg-controls && npm run test:onboarding && npm run test:canon-reconciliation && npm run test:save-state && npm run test:mastery && npm run test:magic-access && npm run test:aether-sense && npm run test:foundation-spell-admission && npm run test:field-roles && npm run test:party-combat-bridge && npm run test:companion-action-admission && npm run test:companion-action-contracts && npm run test:effects && npm run test:registries && npm run test:resolver && npm run test:resolver-integration && npm run test:enemy-metadata && npm run test:combat-input && npm run test:resource-eligibility && npm run test:progression-reachability && npm run test:secondary-action && npm run test:airship && npm run test:air-navigation && npm run test:airship-combat-bridge && npm run test:regressions && npm run test:desktop-package && npm run test:one-file-launcher && npm run test:smoke",
    "test:regressions": "node tests/boot-entrypoint-regression.test.js && node tests/input-dialogue-regression.test.js && node tests/world-quest-lore-ledger-regression.test.js && node tests/shop-regression.test.js && node tests/combat-airship-regression.test.js && node tests/visual-regression.test.js",
    "package:windows": "npm run stage:desktop-runtime && nwbuild --mode=build --glob=false --platform=win --arch=x64 --version=0.116.0 --outDir=../aetherwake-dist build/runtime-app",
    "package:windows:clean": "npm run stage:desktop-runtime && nwbuild --mode=build --glob=false --platform=win --arch=x64 --version=0.116.0 --outDir=../aetherwake-dist build/runtime-app",
    "test:desktop-package": "node tests/desktop-package-contract.test.js",
    "test:onboarding": "node tests/authored-onboarding-contract.test.js",
    "test:save-state": "node tests/save-state-contract.test.js",
    "test:mastery": "node tests/mastery-defs.test.js",
    "test:field-roles": "node tests/field-role-defs.test.js",
    "stage:desktop-runtime": "node scripts/stage-desktop-runtime.js",
    "test:party-combat-bridge": "node tests/party-combat-bridge.test.js",
    "test:companion-action-admission": "node tests/companion-action-admission.test.js",
    "test:magic-access": "node tests/magic-access.test.js",
    "test:companion-action-contracts": "node tests/companion-action-contracts.test.js",
    "test:aether-sense": "node tests/aether-sense.test.js",
    "test:canon-reconciliation": "node tests/canon-reconciliation-contract.test.js",
    "test:foundation-spell-admission": "node tests/foundation-spell-admission.test.js",
    "test:jrpg-input": "node tests/jrpg-input.test.js",
    "test:jrpg-controls": "node tests/jrpg-control-surface.test.js",
    "test:one-file-launcher": "node tests/one-file-launcher-contract.test.js",
    "test:runtime-authority": "node tests/runtime-authority-contract.test.js",
    "test:pixel-sprites": "node tests/pixel-sprite-contract.test.js",
    "test:pixel-tiles": "node tests/pixel-tile-contract.test.js",
    "test:pixel-airship-art": "node tests/pixel-airship-art-contract.test.js",
    "test:pixel-presentation": "node tests/pixel-presentation-contract.test.js",
    "test:pixel-world-ambient": "node tests/pixel-world-ambient-contract.test.js && node tests/16bit-world-art-contract.test.js"
  }
}
