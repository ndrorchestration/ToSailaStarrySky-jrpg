; Native Godot .NET world-map experiment; NOT game canon or a shipping scene.
config_version=5

[application]
config/name="To Sail the Starry Sky — C# Globe Laboratory"
run/main_scene="res://World.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility", "C#")

[dotnet]
project/assembly_name="StarrySkyWorldMapStudy"

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.03, 1)
