; To Sail the Starry Sky: revised First Wake integrated game entry (draft).
; Still a native gameplay candidate, NOT an authorized release or production merge.
config_version=5

[application]

config/name="To Sail the Starry Sky — First Wake Playable Candidate"
run/main_scene="res://scenes/first_wake_game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
